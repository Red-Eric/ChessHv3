{
  "manifest_version": 3,
  "name": "ChessHv3",
  "version": "9.9",
  "description": "Chess Helper Version 3",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {

    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "permissions": [
    "activeTab",
    "debugger",
    "windows",
    "offscreen",
    "tabs",
    "webNavigation",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://*.chess.com/*",
    "https://api.timezonedb.com/*",
    "https://raw.githubusercontent.com/*",
    "https://api.github.com/*",
    "https://lichess.org/*",
    "https://worldchess.com/*",
    "https://fonts.googleapis.com/*",
    "https://text-and-audio.chess.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "alert.js",
        "lib/chess_min.js",
        "lib/maia3/maia3-tokenizer.js",
        "utils/const.js",
        "utils/config.js",
        "utils/engines.js",
        "utils/func.js",
        "utils/draw.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "a.js",
        "b.js",
        "lib/chess_min.js",
        "lib/komodo.js",
        "lib/komodo.wasm",
        "lib/stockfish.wasm",
        "lib/stockfish.js",
        "lib/lozza.js",
        "lib/wukong.js",
        "lib/stockfish6.js",
        "lib/stockfish8.js",
        "lib/stockfish10.js",
        "lib/stockfish11.js",
        "lib/torch.js",
        "lib/torch.wasm",
        "book/book.bin",
        "book/*",
        "audio.html",
        "popup/index.html",
        
        "lib/maia3/all_moves.json",
        "lib/maia3/all_moves_reversed.json",
        "lib/maia3/maia3-5m.onnx",
        "lib/maia3/maia3-engine.js",
        "lib/maia3/maia3-tokenizer.js",
        "lib/maia3/maia3-worker.js",

        "lib/ort/ort-wasm-simd-threaded.wasm",
        "lib/ort/ort-wasm-simd.wasm",
        "lib/ort/ort-wasm-threaded.js",
        "lib/ort/ort-wasm-threaded.wasm",
        "lib/ort/ort-wasm-threaded.worker.js",
        "lib/ort/ort-wasm.wasm",
        "lib/ort/ort.min.js",
        "lib/ort/ort.wasm.min.js"
        
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}